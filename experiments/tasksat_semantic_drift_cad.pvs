tasksat_semantic_drift_cad: THEORY
%----------------------------------------------------------------------------
% Independent CAD characterization of the TaskSAT bounded-assignment drift.
%
% Upstream implementation fact at TaskSAT commit
% f9d6063b45967a3fea578c47f54806aadaafe1b0:
%
%   executable Lean bounded numeric assignment = clamp_B(a)
%   Python/Z3 bounded numeric assignment        = a
%
% A second audit exposed a specification fork in the interval contract:
%
%   public AST/manual:       range is a subtype of bounds        (R subset B)
%   TaskNetPaper skeleton:   bounds are within admissible range  (B subset R)
%   Python wellformedness:   enforces neither containment direction
%
% The formulas below therefore prove both contract branches instead of
% silently choosing one.  All are first-order real polynomial formulas in
% the verified pvs_cad fragment.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cad_decide5, mpoly_embed

  % Graph form of clamp_B(a), kept relational so no IF/min/max is trusted
  % outside CAD.  The existential y is the Lean/reference output; Python/Z3
  % returns a directly.

  assignment_agreement_exact: THEOREM
    FORALL (lo, hi: real):
      FORALL (a: real):
        lo <= hi IMPLIES
          ((EXISTS (y: real):
              ((a < lo AND y = lo) OR
               (lo <= a AND a <= hi AND y = a) OR
               (a > hi AND y = hi))
              AND y = a)
           IFF
           (lo <= a AND a <= hi))

  % Contract branch A: B subset R.
  %
  % Normalize
  %   R = [-left, width + right]
  %   B = [0, width]
  % with left,width,right >= 0.
  %
  % A range-valid assignment outside B exists exactly when R is strictly
  % wider than B on at least one side.

  bounds_inside_range_observable_drift_exact: THEOREM
    FORALL (left, width, right: real):
      left >= 0 AND width >= 0 AND right >= 0 IMPLIES
        ((EXISTS (a: real):
            -left <= a AND a <= width + right
            AND (a < 0 OR a > width))
         IFF
         (left > 0 OR right > 0))

  % Contract branch B: R subset B.
  %
  % Normalize
  %   R = [0, width]
  %   B = [-left, width + right].
  %
  % No range-valid assignment can be outside B.  Therefore the assignment
  % clamp-order difference is observationally invisible to TaskSAT's range
  % predicate on the assignment-only slice under this containment contract.

  range_inside_bounds_no_observable_drift: THEOREM
    FORALL (left, width, right: real):
      left >= 0 AND width >= 0 AND right >= 0 IMPLIES
        NOT (EXISTS (a: real):
          0 <= a AND a <= width
          AND (a < -left OR a > width + right))

  % Candidate repair semantic invariant: after a re-clamp, every bounded
  % assignment result lies in B.

  reclamp_preserves_bounds: THEOREM
    FORALL (lo, hi: real):
      FORALL (a: real):
        lo <= hi IMPLIES
          EXISTS (y: real):
            (((a < lo AND y = lo) OR
              (lo <= a AND a <= hi AND y = a) OR
              (a > hi AND y = hi))
             AND lo <= y AND y <= hi)

  % Minimized executable witness:
  % R=[0,100], B=[0,10], a=20.
  % It is range-valid but outside B: this selects the B-subset-R branch.

  minimized_witness_is_observable: THEOREM
    0 <= 20 AND 20 <= 100 AND (20 < 0 OR 20 > 10)

  minimized_witness_contract_direction: THEOREM
    (0 <= 0 AND 10 <= 100) AND NOT (100 <= 10)

END tasksat_semantic_drift_cad
