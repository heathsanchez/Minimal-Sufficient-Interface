tasksat_semantic_drift_cad: THEORY
%----------------------------------------------------------------------------
% Verified-CAD characterization of TaskSAT's bounded-assignment semantic fork.
%
% IMPORTANT pvs_cad interface discipline:
%   cad-prefix accepts one real binding per quantifier node.
% Therefore every quantified variable below has its own explicit
% FORALL/EXISTS binder.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cad_decide5, mpoly_embed

  % On the clamp graph, the Lean/reference output y equals Python/Z3's
  % direct assignment output a exactly when a is inside the bounds.

  assignment_agreement_exact: THEOREM
    FORALL (lo: real):
      FORALL (hi: real):
        FORALL (a: real):
          FORALL (y: real):
            (lo <= hi
             AND
             ((a < lo AND y = lo)
              OR (lo <= a AND a <= hi AND y = a)
              OR (a > hi AND y = hi)))
            IMPLIES
              ((y = a IMPLIES (lo <= a AND a <= hi))
               AND
               ((lo <= a AND a <= hi) IMPLIES y = a))

  % Contract A: bounds inside admissible range (B subset R).
  % R=[-left,width+right], B=[0,width].
  % Any range-valid separator forces strict extra range on a side.

  bounds_inside_range_drift_only_if_wider: THEOREM
    FORALL (left: real):
      FORALL (width: real):
        FORALL (right: real):
          FORALL (a: real):
            (left >= 0 AND width >= 0 AND right >= 0
             AND -left <= a AND a <= width + right
             AND (a < 0 OR a > width))
            IMPLIES
              (left > 0 OR right > 0)

  % Converse: strict extra range on a side supplies an admissible separator.

  bounds_inside_range_wider_has_drift: THEOREM
    FORALL (left: real):
      FORALL (width: real):
        FORALL (right: real):
          EXISTS (a: real):
            (left >= 0 AND width >= 0 AND right >= 0)
            IMPLIES
              ((left > 0 OR right > 0)
               IMPLIES
                 (-left <= a AND a <= width + right
                  AND (a < 0 OR a > width)))

  % Contract B: admissible range inside bounds (R subset B).
  % R=[0,width], B=[-left,width+right].
  % Every admissible point is inside B.

  range_inside_bounds_no_observable_drift: THEOREM
    FORALL (left: real):
      FORALL (width: real):
        FORALL (right: real):
          FORALL (a: real):
            (left >= 0 AND width >= 0 AND right >= 0
             AND 0 <= a AND a <= width)
            IMPLIES
              NOT (a < -left OR a > width + right)

  % Candidate repair invariant: clamp-graph output exists and is bounded.

  reclamp_preserves_bounds: THEOREM
    FORALL (lo: real):
      FORALL (hi: real):
        FORALL (a: real):
          EXISTS (y: real):
            lo <= hi
            IMPLIES
              (((a < lo AND y = lo)
                OR (lo <= a AND a <= hi AND y = a)
                OR (a > hi AND y = hi))
               AND lo <= y AND y <= hi)

  % Concrete minimized witness; one unused real keeps the theorem inside
  % cad-direct's quantified interface.

  minimized_witness_is_observable: THEOREM
    FORALL (dummy: real):
      0 <= 20 AND 20 <= 100 AND (20 < 0 OR 20 > 10)

  minimized_witness_contract_direction: THEOREM
    FORALL (dummy: real):
      (0 <= 0 AND 10 <= 100) AND NOT (100 <= 10)

END tasksat_semantic_drift_cad
