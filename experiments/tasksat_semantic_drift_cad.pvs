tasksat_semantic_drift_cad: THEORY
%----------------------------------------------------------------------------
% Verified-CAD characterization of the OBSERVABLE validity difference between
% TaskSAT's two bounded-assignment transition meanings.
%
% Pinned implementation divergence:
%   Lean/reference output = clamp_B(a)
%   Python/Z3 output       = a
%
% Validity is determined by membership of the resulting value in the timeline
% admissible range R.  The protected observation is therefore whether
% clamp_B(a) in R differs from a in R.
%
% Every theorem uses one real binding per quantifier node, exactly matching
% pvs_cad's cad-prefix interface.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cad_decide5, mpoly_embed

  assignment_output_agreement_exact: THEOREM
    FORALL (lo: real):
      FORALL (hi: real):
        FORALL (a: real):
          FORALL (y: real):
            (lo <= hi
             AND
             ((a < lo AND y = lo)
              OR (lo <= a AND a <= hi AND y = a)
              OR (a > hi AND y = hi)))
            IMPLIES
              ((y = a IMPLIES (lo <= a AND a <= hi))
               AND
               ((lo <= a AND a <= hi) IMPLIES y = a))

  % Public/current R subset B branch.
  % Normalize B=[0,W], R=[p,W-q].
  % If R is strictly interior to B, the two output values may differ but the
  % range-validity verdict cannot differ.

  r_subset_b_strict_interior_validity_agreement: THEOREM
    FORALL (W: real):
      FORALL (p: real):
        FORALL (q: real):
          FORALL (a: real):
            FORALL (y: real):
              (W >= 0 AND p > 0 AND q > 0 AND p + q <= W
               AND
               ((a < 0 AND y = 0)
                OR (0 <= a AND a <= W AND y = a)
                OR (a > W AND y = W)))
              IMPLIES
                (((p <= y AND y <= W - q)
                  IMPLIES
                  (p <= a AND a <= W - q))
                 AND
                 ((p <= a AND a <= W - q)
                  IMPLIES
                  (p <= y AND y <= W - q)))

  % If R touches the lower clamp endpoint, a=-1 separates validity.

  r_subset_b_lower_touch_has_validity_divergence: THEOREM
    FORALL (W: real):
      FORALL (q: real):
        (W >= 0 AND q >= 0 AND q <= W)
        IMPLIES
          (((-1 < 0 AND 0 = 0)
            OR (0 <= -1 AND -1 <= W AND 0 = -1)
            OR (-1 > W AND 0 = W))
           AND (0 <= 0 AND 0 <= W - q)
           AND NOT (0 <= -1 AND -1 <= W - q))

  % If R touches the upper clamp endpoint, a=W+1 separates validity.

  r_subset_b_upper_touch_has_validity_divergence: THEOREM
    FORALL (W: real):
      FORALL (p: real):
        (W >= 0 AND p >= 0 AND p <= W)
        IMPLIES
          ((((W + 1) < 0 AND W = 0)
            OR (0 <= W + 1 AND W + 1 <= W AND W = W + 1)
            OR (W + 1 > W AND W = W))
           AND (p <= W AND W <= W)
           AND NOT (p <= W + 1 AND W + 1 <= W))

  % Opposite B subset R branch.
  % Normalize B=[0,W], R=[-left,W+right].  Since assignments themselves are
  % not statically restricted to R, a=-left-1 always separates validity.

  b_subset_r_always_has_validity_divergence: THEOREM
    FORALL (left: real):
      FORALL (W: real):
        FORALL (right: real):
          (left >= 0 AND W >= 0 AND right >= 0)
          IMPLIES
            (((-left - 1 < 0 AND 0 = 0)
              OR (0 <= -left - 1 AND -left - 1 <= W AND 0 = -left - 1)
              OR (-left - 1 > W AND 0 = W))
             AND (-left <= 0 AND 0 <= W + right)
             AND NOT (-left <= -left - 1 AND -left - 1 <= W + right))

  % Candidate repair invariant.

  reclamp_preserves_bounds: THEOREM
    FORALL (lo: real):
      FORALL (hi: real):
        FORALL (a: real):
          EXISTS (y: real):
            lo <= hi
            IMPLIES
              (((a < lo AND y = lo)
                OR (lo <= a AND a <= hi AND y = a)
                OR (a > hi AND y = hi))
               AND lo <= y AND y <= hi)

  % Contract-compliant executable witness under R subset B:
  % R=[10,100], B=[0,100], assignment a=110, reference output y=100.

  contract_compliant_witness_has_validity_divergence: THEOREM
    FORALL (dummy: real):
      (0 <= 10 AND 100 <= 100)
      AND
      (((110 < 0 AND 100 = 0)
        OR (0 <= 110 AND 110 <= 100 AND 100 = 110)
        OR (110 > 100 AND 100 = 100))
       AND (10 <= 100 AND 100 <= 100)
       AND NOT (10 <= 110 AND 110 <= 100))

  % Historical minimized witness R=[0,100], B=[0,10], a=20.  It belongs to
  % the opposite containment branch and is retained only as lineage.

  historical_witness_is_b_subset_r: THEOREM
    FORALL (dummy: real):
      (0 <= 0 AND 10 <= 100) AND NOT (100 <= 10)

END tasksat_semantic_drift_cad
