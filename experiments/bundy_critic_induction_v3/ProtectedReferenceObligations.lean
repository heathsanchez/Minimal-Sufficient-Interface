import Std
import FrozenSource

/-! V3 independently checkable protected obligations.
    This is a verifier/reference probe, NOT generated by the critic. -/
namespace BundyInductionV3

theorem sum_acc (acc : Nat) (xs : List Nat) :
    sumAccum acc xs = sumPlain xs + acc := by
  induction xs generalizing acc with
  | nil => simp [sumAccum, sumPlain]
  | cons x xs ih =>
    simp only [sumAccum, sumPlain]
    rw [ih]
    omega

theorem prod_acc (acc : Nat) (xs : List Nat) :
    prodAccum acc xs = prodPlain xs * acc := by
  induction xs generalizing acc with
  | nil => simp [prodAccum, prodPlain]
  | cons x xs ih =>
    simp only [prodAccum, prodPlain]
    rw [ih]
    simp [Nat.mul_assoc, Nat.mul_comm, Nat.mul_left_comm]

theorem map_rev_acc (f : Nat → Nat) (acc xs : List Nat) :
    mapRevAccum f acc xs = mapRevPlain f xs ++ acc := by
  induction xs generalizing acc with
  | nil => simp [mapRevAccum, mapRevPlain]
  | cons x xs ih =>
    simp only [mapRevAccum, mapRevPlain]
    rw [ih]
    simp [List.append_assoc]

theorem words_acc (acc : List Nat) (xs : List (List Nat)) :
    wordsAccum acc xs = wordsPlain xs ++ acc := by
  induction xs generalizing acc with
  | nil => simp [wordsAccum, wordsPlain]
  | cons x xs ih =>
    simp only [wordsAccum, wordsPlain]
    rw [ih]
    simp [List.append_assoc]

theorem bad_orientation_false :
    ¬ (∀ acc xs : List Nat, badAccum acc xs = badPlain xs ++ acc) := by
  intro h
  have hbad := h [1] [2]
  have hne : badAccum [1] [2] ≠ badPlain [2] ++ [1] := by decide
  exact hne hbad

end BundyInductionV3
